{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-revenue-audit.local/schemas/billing-item.json",
  "title": "BillingItem",
  "type": "object",
  "required": ["project_id", "billing_id", "line_id", "amount"],
  "properties": {
    "project_id": { "type": "string" },
    "billing_id": { "type": "string" },
    "billing_period": { "type": ["string", "null"] },
    "invoice_number": { "type": ["string", "null"] },
    "line_id": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "cost_code": { "type": ["string", "null"] },
    "change_order_id": { "type": ["string", "null"] },
    "change_order_line_number": { "type": ["integer", "null"] },
    "amount": { "type": "number" },
    "quantity": { "type": ["number", "null"] },
    "unit_price": { "type": ["number", "null"] },
    "unit": { "type": ["string", "null"] },
    "retainage": { "type": ["number", "null"] },
    "billed_to_date": { "type": ["number", "null"] },
    "billing_date": { "type": ["string", "null"], "format": "date" },
    "source_reference": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
